<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Filter chip used above the roadworks list -->
    <style name="FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Filter chip with a coloured dot (colour set in code) that works as a legend -->
    <style name="FilterChip.Dot">
        <item name="chipIcon">@drawable/bg_icon_circle</item>
        <item name="chipIconVisible">true</item>
        <item name="chipIconSize">12dp</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
