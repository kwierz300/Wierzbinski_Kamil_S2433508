<?xml version="1.0" encoding="utf-8"?>
<!-- List of situations with tabs for incidents and roadworks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Legend for the roadworks colour coding (roadworks tab only) -->
    <LinearLayout
        android:id="@+id/legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/legendShort"
            style="@style/LegendBadge"
            android:text="@string/legend_short" />

        <TextView
            android:id="@+id/legendMedium"
            style="@style/LegendBadge"
            android:text="@string/legend_medium" />

        <TextView
            android:id="@+id/legendLong"
            style="@style/LegendBadge"
            android:text="@string/legend_long" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"
        tools:text="@string/list_empty" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />
</LinearLayout>
